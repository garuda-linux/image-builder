{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "schedule": ["before 6am on monday"],
  "timezone": "UTC",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"]
  },
  "nix": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^mkosi\\.conf$/"],
      "matchStrings": [
        "ToolsTreeSnapshot=(?<currentValue>\\d{4}/\\d{2}/\\d{2})"
      ],
      "depNameTemplate": "archlinux-archive",
      "datasourceTemplate": "custom.archlinux-archive",
      "versioningTemplate": "regex:^(?<major>\\d{4})/(?<minor>\\d{2})/(?<patch>\\d{2})$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^ci/iso_pipeline\\.py$/"],
      "matchStrings": [
        "image: (?<depName>[a-z0-9./-]+):(?<currentValue>[0-9][0-9.]*)"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "customDatasources": {
    "archlinux-archive": {
      "defaultRegistryUrlTemplate": "https://archive.archlinux.org/repos/last/lastsync",
      "format": "plain",
      "transformTemplates": [
        "{\"releases\": [{\"version\": $fromMillis($number(releases[0].version) * 1000, '[Y0001]/[M01]/[D01]')}]}"
      ]
    }
  },
  "packageRules": [
    {
      "description": "Dated base tags of the builder image, such as base-20261101.0.620205",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["docker.io/library/archlinux", "archlinux"],
      "versioning": "regex:^base-(?<major>\\d{8})\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    },
    {
      "description": "A new tools tree changes every build: let the merge request build the distrobox image",
      "matchDepNames": ["archlinux-archive"],
      "commitMessageTopic": "mkosi tools tree snapshot",
      "commitMessageSuffix": "[build distrobox]"
    }
  ]
}
