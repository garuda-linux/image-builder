#!/bin/sh
# Started once after the first login on the VM image (autostart entry of the
# user, written by lib/vm.sh of the image builder): the image comes with the
# password garuda, this asks to change it, then removes its autostart entry.

entry="${XDG_CONFIG_HOME:-$HOME/.config}/autostart/garuda-vm-password.desktop"

if notify-send --urgency=critical --app-name=Garuda "Change your password" \
  "This virtual machine came with the password \"garuda\". Set your own in a terminal with: passwd"; then
  rm -f "$entry"
fi
