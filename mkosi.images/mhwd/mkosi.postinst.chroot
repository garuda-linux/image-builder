#!/bin/bash
set -euo pipefail

repo=/opt/ght/pkg
mkdir -p "$repo"

# A temporary keyring checks the downloaded driver packages. It is not kept:
# on the ISO the repository sits on the dm-verity protected layer, so
# pacman-ght.conf has SigLevel = Never for it, and a kept keyring would carry
# a new private master key on every build.
ght_gpg="$(mktemp -d)"
pacman-key --gpgdir "$ght_gpg" --init
pacman-key --gpgdir "$ght_gpg" --populate

# shellcheck disable=SC2086 # MHWD_PACKAGES is a space-separated list
pacman -Syw --noconfirm --gpgdir "$ght_gpg" --cachedir "$repo" ${MHWD_PACKAGES}

gpgconf --homedir "$ght_gpg" --kill all
rm -rf "$ght_gpg"

# <name>-<pkgver>-<pkgrel>-<arch>.pkg.tar.<ext>, the name may hold dashes
pkg_name() {
  local base="${1##*/}"
  base="${base%.pkg.tar*}"
  echo "${base%-*-*-*}"
}

# The download sees only the repositories of pacman.conf, not mkosi's local
# repository. Packages of mkosi.packages/ ($PACKAGEDIR) replace their download.
for local_pkg in "$PACKAGEDIR"/*.pkg.tar*; do
  [[ -f "$local_pkg" && "$local_pkg" != *.sig ]] || continue

  name="$(pkg_name "$local_pkg")"
  replaced=false

  for file in "$repo"/*.pkg.tar*; do
    [[ "$file" != *.sig && "$(pkg_name "$file")" == "$name" ]] || continue
    rm -f -- "$file" "$file.sig"
    replaced=true
  done

  if [[ "$replaced" == true ]]; then
    cp -- "$local_pkg" "$repo/"
    echo "local package ${local_pkg##*/} replaces the download"
  fi
done

# The .sig files stay next to the packages, repo-add puts them into the database
packages=()
for file in "$repo"/*.pkg.tar*; do
  [[ "$file" == *.sig ]] || packages+=("$file")
done
repo-add "$repo/ght.db.tar.gz" "${packages[@]}"

# repo-add stamps the build time on the archive entries. Repacked with sorted
# entries and SOURCE_DATE_EPOCH, they only change with their content.
repack() {
  local archive="$1" tmp
  tmp="$(mktemp -d)"
  bsdtar -xf "$archive" -C "$tmp"
  find "$tmp" -exec touch -h -d "@${SOURCE_DATE_EPOCH:?}" {} +
  (cd "$tmp" && find . -mindepth 1 -printf '%P\n' | LC_ALL=C sort |
    bsdtar --format=ustar --uid 0 --gid 0 --numeric-owner --no-recursion -cf - -T -) |
    gzip -9 -n >"$archive"
  rm -rf "$tmp"
}
repack "$repo/ght.db.tar.gz"
repack "$repo/ght.files.tar.gz"

# Only the driver repository belongs in this layer
rm -f /var/lib/pacman/sync/* /var/log/pacman.log
