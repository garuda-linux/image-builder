[Unit]
Description=Garuda live layers
Documentation=file:///usr/bin/garuda-live-mount
DefaultDependencies=no
# The script waits for the boot medium itself, by its label
After=systemd-udev-trigger.service systemd-udevd.service
Before=sysroot.mount

[Service]
Type=oneshot
RemainAfterExit=yes
# The verity check and copy messages belong on the screen
StandardOutput=journal+console
ExecStart=/usr/bin/garuda-live-mount
