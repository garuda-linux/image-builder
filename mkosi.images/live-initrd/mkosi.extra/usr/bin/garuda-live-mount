#!/bin/sh
# Kernel command line options:
#   garuda.label=<label>     the El Torito volume label of the boot medium, set by build.sh
#   garuda.verity=<layer>:<root hash>,...
#                            the dm-verity root hash of each layer, set by build.sh.
#                            Every block read from a layer is checked against it.
#   checksum, checksum=y     read every layer once before the boot, so a damaged
#                            medium shows up now and not later in the session
#   copytoram, copytoram=y   copy the layers to RAM so the boot medium can be removed,
#                            if they fit with 2 GiB to spare
#   copytoram_size=<size>    size of that tmpfs (default 75%)
#   overlay_root_size=<size> size of the writable tmpfs layer (default 75%)
#   persistence              keep the writable layer on the ext4 partition GARUDA_PERSIST
#                            of the boot stick, created behind the image if missing
#   persistence=any          also accept GARUDA_PERSIST on another disk
#
# The boot medium is the disk with the volume label, or the ISO file on a
# Ventoy stick or another disk, see find_medium.

set -e

# shellcheck source=mkosi.images/live-initrd/mkosi.extra/usr/lib/garuda-live/cmdline.sh
. /usr/lib/garuda-live/cmdline.sh

say() { echo "garuda-live: $*"; }

label="$(arg garuda.label)"
verity="$(arg garuda.verity)"
layers="root desktop drivers live"
persist_label=GARUDA_PERSIST

# wait_for <seconds> <command...>: run the command until it succeeds
wait_for() {
  n="$1"
  shift
  while ! "$@"; do
    [ "$n" -gt 0 ] || return 1
    sleep 1
    udevadm settle
    n=$((n - 1))
  done
}

# The root hash of a layer from garuda.verity=
roothash() {
  old_ifs="$IFS"
  IFS=,
  for entry in $verity; do
    case "$entry" in
      "$1":*) echo "${entry#*:}" ;;
    esac
  done
  IFS="$old_ifs"
}

# The partition with the given name on the boot disk
part() {
  lsblk -l -n -p -o NAME,PARTLABEL "$disk" 2>/dev/null | while read -r name partlabel; do
    if [ "$partlabel" = "$1" ]; then
      echo "$name"
    fi
  done | head -n1
}

have_parts() {
  for layer in $layers; do
    [ -n "$(part "garuda-$layer")" ] && [ -n "$(part "garuda-$layer-verity")" ] || return 1
  done
}

# The persistence partition. Only the boot stick counts, so a disk with that
# label plugged in by someone else cannot take over the session. persistence=any
# accepts every disk.
find_persistence() {
  if [ "$(arg persistence)" = any ]; then
    blkid -l -o device -t PARTLABEL="$persist_label" 2>/dev/null ||
      blkid -l -o device -t LABEL="$persist_label" 2>/dev/null || true
    return 0
  fi
  # Sticks from older ISOs carry the name as file system label
  lsblk -l -n -p -o NAME,PARTLABEL,LABEL "$disk" 2>/dev/null | while read -r name partlabel fslabel; do
    if [ "$partlabel" = "$persist_label" ] || [ "$fslabel" = "$persist_label" ]; then
      echo "$name"
    fi
  done | head -n1
}

has_persistence() { [ -n "$(find_persistence)" ]; }

# Only touches the boot stick: the whole disk must carry the volume label of
# this image. CDs are left alone. systemd-repart adds the partition of
# /usr/lib/garuda-live/repart.d in the free space behind the image and keeps
# the partitions it has no definition for.
create_persistence() {
  if [ "$cd_boot" = yes ]; then
    say "persistence needs a USB stick or disk, not a CD"
    return 1
  fi

  if [ "$file_boot" = yes ]; then
    say "persistence needs the image written to the stick, not an ISO file on it"
    return 1
  fi

  if [ "$(blkid -p -s LABEL -o value "$disk" 2>/dev/null)" != "$label" ]; then
    say "persistence: $disk is not the boot stick of $label, not changing it"
    return 1
  fi

  say "creating the persistence partition on $disk"
  if ! systemd-repart --no-pager --dry-run=no --definitions=/usr/lib/garuda-live/repart.d "$disk"; then
    say "persistence: could not add the partition to $disk, it needs at least 1 GiB free"
    return 1
  fi
  udevadm settle
}

# Messages of the functions whose stdout is captured
note() { say "$*" >&2; }

# hex <file> <offset> <length>: the bytes as one hex string
hex() {
  od -A n -v -t x1 -j "$2" -N "$3" "$1" 2>/dev/null | tr -d ' \n'
}

# The ISO 9660 volume ID has no spaces (iso_label in lib/iso.sh), tr strips the padding
has_label() {
  [ "$(dd if="$1" bs=1 skip=32808 count=32 2>/dev/null | tr -d '\000 ')" = "$label" ]
}

# mount_ro <device> <dir>: read-only, without journal replay
mount_ro() {
  fstype="$(blkid -p -s TYPE -o value "$1" 2>/dev/null)"
  case "$fstype" in
    exfat | udf | vfat) options=ro ;;
    ntfs) fstype=ntfs3 options=ro ;;
    ext2 | ext3 | ext4) fstype=ext4 options=ro,noload ;;
    xfs) options=ro,norecovery ;;
    *) return 1 ;;
  esac
  mount -t "$fstype" -o "$options" "$1" "$2"
}

# The file system under the file stays mounted while the loop device uses it
attach() {
  has_label "$1" || return 1
  loop="$(losetup -f -r -P --show "$1")" || return 1
  if [ "$(blkid -p -s LABEL -o value "$loop" 2>/dev/null)" != "$label" ]; then
    losetup -d "$loop"
    return 1
  fi
  echo "$loop"
}

# Ventoy boots the ISO through a firmware CD drive that Linux does not see and
# leaves its location in ventoy_os_param (VtoyTool/vtoytool.h of Ventoy).
ventoy_var=/sys/firmware/efi/efivars/VentoyOsParam-77772020-2e77-6576-6e74-6f792e6e6574
ventoy_failed=/run/garuda/ventoy-failed

ventoy_image() {
  [ -e "$ventoy_var" ] && [ ! -e "$ventoy_failed" ] || return 1

  # VENTOY_GUID in memory order ("  www.ventoy.net"), then a byte sum of 0
  [ "$(hex "$ventoy_var" 4 16)" = 20207777772e76656e746f792e6e6574 ] || return 1
  sum=0
  for b in $(od -A n -v -t u1 -j 4 -N 512 "$ventoy_var"); do
    sum=$((sum + b))
  done
  [ $((sum % 256)) -eq 0 ] || return 1

  # Struct offsets, +4 for the efivarfs attributes. Disk GUID (17) and
  # signature (481) match bytes 0x180 and 0x1b8 of the Ventoy disk.
  guid="$(hex "$ventoy_var" 21 16)"
  sig="$(hex "$ventoy_var" 485 4)"
  vdisk=""
  for sys in /sys/block/*; do
    name="${sys##*/}"
    case "$name" in loop* | ram* | zram* | dm-* | sr*) continue ;; esac
    if [ "$(hex "/dev/$name" 384 16)" = "$guid" ] && [ "$(hex "/dev/$name" 440 4)" = "$sig" ]; then
      vdisk="$name"
    fi
  done

  # The stick may not be there yet
  [ -n "$vdisk" ] || return 1

  # vtoy_disk_part_id at 41 (from 1), vtoy_img_path at 45
  partn="$(od -A n -t u2 -j 45 -N 2 "$ventoy_var" | tr -d ' ')"
  path="$(dd if="$ventoy_var" bs=1 skip=49 count=384 2>/dev/null | tr '\000' '\n' | head -n1)"
  vpart=""
  for sys in "/sys/block/$vdisk/$vdisk"*; do
    if [ "$(cat "$sys/partition" 2>/dev/null)" = "$partn" ]; then
      vpart="/dev/${sys##*/}"
    fi
  done

  mkdir -p /run/garuda
  : >"$ventoy_failed"
  if [ -z "$vpart" ]; then
    note "Ventoy: partition $partn of /dev/$vdisk not found"
    return 1
  fi

  mkdir -p /run/garuda/image-fs
  if ! mount_ro "$vpart" /run/garuda/image-fs; then
    note "Ventoy: could not mount $vpart"
    return 1
  fi
  if ! attach "/run/garuda/image-fs$path"; then
    note "Ventoy: $path on $vpart is not the image $label"
    umount /run/garuda/image-fs
    return 1
  fi
  note "Ventoy: booting the image $path on $vpart"
}

# The disk and its partitions, for each USB stick and SD card
removable_devices() {
  lsblk -d -n -p -o NAME,RM,TRAN 2>/dev/null | while read -r sdisk rm tran; do
    case "$sdisk" in
      /dev/sr* | /dev/loop* | /dev/zram*) continue ;;
      /dev/mmcblk*) ;;
      *) [ "$rm" = 1 ] || [ "$tran" = usb ] || continue ;;
    esac
    lsblk -l -n -p -o NAME "$sdisk" 2>/dev/null
  done
}

# For Ventoy memdisk mode, GRUB loopback and similar. Internal disks are left
# alone. A file with the right label but other layers fails the verity check.
search_image() {
  mkdir -p /run/garuda/image-fs
  for dev in $(removable_devices); do
    grep -q "^$dev " /proc/mounts && continue
    mount_ro "$dev" /run/garuda/image-fs 2>/dev/null || continue

    loop="$(find /run/garuda/image-fs -maxdepth 3 -type f -iname '*.iso' 2>/dev/null | while IFS= read -r file; do
      if attach "$file"; then
        note "booting the image ${file#/run/garuda/image-fs} on $dev"
        break
      fi
    done)"

    if [ -n "$loop" ]; then
      echo "$loop"
      return 0
    fi

    umount /run/garuda/image-fs
  done

  return 1
}

# The search mounts file systems, so a written stick gets 10 s first
find_medium() {
  if [ -e "/dev/disk/by-label/$label" ]; then
    readlink -f "/dev/disk/by-label/$label"
    return 0
  fi

  ventoy_image && return 0

  [ "$1" -ge 10 ] && [ $(($1 % 10)) -eq 0 ] && search_image
}

waited=0
until medium="$(find_medium "$waited")"; do
  if [ "$waited" -ge 90 ]; then
    say "no medium with the label $label found, and no ISO file of it on a Ventoy or other removable disk"
    exit 1
  fi

  sleep 1
  udevadm settle
  waited=$((waited + 1))
done

# The kernel does not read the GPT of a CD drive (2048-byte sectors). udev
# notices that the boot disk then needs a loop device, and
# systemd-loop@.service attaches one with partition scan (99-systemd.rules of
# systemd), after systemd-dissect checked the image. The partitions of the ISO
# are typed for that, see write_repart_definitions in lib/iso.sh.
cd_boot=no
file_boot=no
case "$medium" in
  /dev/loop*)
    # The ISO file, attached by ventoy_image or search_image
    file_boot=yes
    disk="$medium"
    ;;
  /dev/sr*)
    cd_boot=yes
    # The loop device systemd attached for the drive
    cd_loop() { losetup -n -O NAME -j "$medium" 2>/dev/null | head -n1; }
    has_cd_loop() { [ -n "$(cd_loop)" ]; }
    if ! wait_for 60 has_cd_loop; then
      say "systemd-loop@.service attached no loop device for $medium, see its journal"
      exit 1
    fi
    disk="$(cd_loop)"
    ;;
  *)
    disk="/dev/$(lsblk -n -o PKNAME "$medium" | head -n1)"
    [ "$disk" != /dev/ ] || disk="$medium"
    ;;
esac

if ! wait_for 10 have_parts; then
  say "the layer partitions are missing on $disk"
  exit 1
fi

for layer in $layers; do
  if [ -z "$(roothash "$layer")" ]; then
    say "garuda.verity= has no root hash for $layer: the boot entry was changed"
    exit 1
  fi
done

mkdir -p /run/garuda/rw
persistent=no

if flag persistence || [ "$(arg persistence)" = any ]; then
  dev="$(find_persistence)"
  if [ -z "$dev" ] && create_persistence; then
    wait_for 10 has_persistence || true
    dev="$(find_persistence)"
  fi

  if [ -n "$dev" ]; then
    # One directory per image, so a new version starts with a clean state
    mkdir -p /run/garuda/persist
    if mount -t ext4 "$dev" /run/garuda/persist &&
      mkdir -p "/run/garuda/persist/$label" &&
      mount --bind "/run/garuda/persist/$label" /run/garuda/rw; then
      persistent=yes
      say "persistence on $dev ($label)"
      for other in /run/garuda/persist/*/; do
        other="${other%/}"
        name="${other##*/}"
        if [ -d "$other" ] && [ "$name" != "$label" ] && [ "$name" != lost+found ]; then
          say "persistence: $dev also holds $name of another image ($(du -sh "$other" 2>/dev/null | cut -f1)), remove it to free space"
        fi
      done
    else
      say "persistence: could not mount $dev, changes stay in RAM"
      umount /run/garuda/persist 2>/dev/null || true
    fi
  else
    say "no persistence partition, changes stay in RAM"
  fi
fi

if [ "$persistent" = no ]; then
  mount -t tmpfs -o "mode=0755,size=$(arg overlay_root_size | grep . || echo 75%)" garuda-live-rw /run/garuda/rw
fi

mkdir -p /run/garuda/rw/upper /run/garuda/rw/work

# The data and hash tree of each layer, on the medium or in RAM
mkdir -p /run/garuda/src
for layer in $layers; do
  ln -sf "$(part "garuda-$layer")" "/run/garuda/src/$layer"
  ln -sf "$(part "garuda-$layer-verity")" "/run/garuda/src/$layer.verity"
done
src=/run/garuda/src

# The tmpfs size is only a cap. Copying more than the free RAM ends in the OOM
# killer, so the initrd, the writable layer and the live session keep 2 GiB.
copytoram_fits() {
  need=0
  for layer in $layers; do
    need=$((need + $(blockdev --getsize64 "$src/$layer") + $(blockdev --getsize64 "$src/$layer.verity")))
  done

  avail=0
  while read -r key value _; do
    if [ "$key" = MemAvailable: ]; then
      avail=$((value * 1024))
    fi
  done </proc/meminfo

  if [ $((need + 2147483648)) -gt "$avail" ]; then
    say "copytoram: the layers need $((need >> 20)) MiB plus 2048 MiB free, $((avail >> 20)) MiB available. Booting from the medium."
    return 1
  fi
}

copied=no
if flag copytoram && copytoram_fits; then
  say "copying the layers to RAM"
  mkdir -p /run/garuda/copytoram
  mount -t tmpfs -o "mode=0755,size=$(arg copytoram_size | grep . || echo 75%)" copytoram /run/garuda/copytoram

  copied=yes
  for layer in $layers; do
    for f in "$layer" "$layer.verity"; do
      cat "$src/$f" >"/run/garuda/copytoram/$f" || copied=no
    done
  done

  if [ "$copied" = yes ]; then
    src=/run/garuda/copytoram
  else
    say "copytoram: copying failed, booting from the medium"
    umount /run/garuda/copytoram
  fi
fi

# After copytoram this checks the RAM copy, so the medium is read only once
if flag checksum; then
  say "checking the layers, this takes a while"
  for layer in $layers; do
    if ! veritysetup verify "$src/$layer" "$src/$layer.verity" "$(roothash "$layer")"; then
      say "the $layer layer is damaged: write the image again or use another medium"
      exit 1
    fi
  done
  say "the layers are intact"
fi

# veritysetup takes the files of copytoram as well and puts them on loop devices
for layer in $layers; do
  if ! veritysetup open "$src/$layer" "garuda-$layer" "$src/$layer.verity" "$(roothash "$layer")"; then
    say "the $layer layer does not match garuda.verity= of the boot entry"
    exit 1
  fi
  mkdir -p "/run/garuda/layers/$layer"
  mount -t erofs -o ro "/dev/mapper/garuda-$layer" "/run/garuda/layers/$layer"
done

# Not on a CD or from an ISO file: the loop device keeps the drive in use
if [ "$copied" = yes ] && [ "$persistent" = no ] && [ "$cd_boot" = no ] && [ "$file_boot" = no ]; then
  say "the boot medium can be removed"
fi
