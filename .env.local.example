# Copy to .env.local. The shell wins over this file. KEY=value, no expansion.

# Build, see ./build.sh --help
# VERSION=20261114
# ISO_COMPRESSION=fast
# BUILDER_UPDATE=ask

# Secure Boot signing, see docs/building.md#signing
# SB_KEY=/path/to/signer.key
# SB_CERT=/path/to/signer.crt
# SB_CA_CERT=/path/to/ca.crt

# Tests
# TEST_RAM=6G

# openQA, for build test iso <edition> --openqa
# OPENQA_DISTRI=../openqa-distri
# SCENARIO=install
# ISOTOVIDEO_IMAGE=registry.gitlab.com/garuda-linux/tools/image-builder/openqa:latest

# build pkg
# GARUDA_PKGBUILDS=../pkgbuilds

# build virt, libvirt network and storage pool on qemu:///system
# VIRT_NETWORK=default
# VIRT_POOL=default
